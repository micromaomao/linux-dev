#define CPU_MIN 8

t:syscalls:sys_enter_open, t:syscalls:sys_enter_openat, t:syscalls:sys_enter_openat2 /cpu >= CPU_MIN && !@open_syscall_start_time[tid]/
{
	@open_syscall_start_time[tid] = nsecs;
}

kfunc:hook_file_open /cpu >= CPU_MIN && @open_syscall_start_time[tid]/
{
	@hook_open_start_time[tid] = nsecs;
}

kretfunc:hook_file_open /cpu >= CPU_MIN && @open_syscall_start_time[tid] && @hook_open_start_time[tid]/
{
	$duration = nsecs - @hook_open_start_time[tid];
	@hook_open_duration[tid] += $duration;
	delete(@hook_open_start_time[tid]);
}

t:syscalls:sys_exit_open, t:syscalls:sys_exit_openat, t:syscalls:sys_exit_openat2 /cpu >= CPU_MIN && @open_syscall_start_time[tid]/
{
	$duration_open_syscall = nsecs - @open_syscall_start_time[tid];
	$duration_hook_file_open = @hook_open_duration[tid];
	@latency["hook_file_open"] = lhist($duration_hook_file_open, 250, 2000, 100);
	@latency["open_syscall"] = lhist($duration_open_syscall, 250, 2000, 100);
	$overhead_percent = ($duration_hook_file_open * 100) / $duration_open_syscall;
	@landlock_overhead["hook_file_open"] = lhist($overhead_percent, 0, 100, 10);
	delete(@open_syscall_start_time[tid]);
	delete(@hook_open_duration[tid]);
}
